{
  "name": "@oryanomer1/whoop-mcp",
  "version": "1.0.0",
  "description": "Read-only MCP server for your WHOOP data: recovery, HRV, sleep, strain, workouts and trends.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "whoop",
    "claude",
    "health",
    "fitness",
    "hrv",
    "sleep",
    "mcp-server",
    "whoop-api",
    "wearables",
    "recovery",
    "strain",
    "quantified-self",
    "read-only"
  ],
  "homepage": "https://github.com/oryanomer1/whoop-mcp#readme",
  "bugs": "https://github.com/oryanomer1/whoop-mcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oryanomer1/whoop-mcp.git"
  },
  "license": "MIT",
  "author": "Oryan Omer",
  "type": "module",
  "bin": {
    "whoop-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test:coverage": "vitest run --coverage",
    "version": "node scripts/sync-server-json.mjs && git add server.json",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "smoke:live": "npm run build && node scripts/live-smoke.mjs",
    "bundle": "node scripts/build-mcpb.mjs",
    "demo": "npm run build && node scripts/demo.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "mcpName": "io.github.oryanomer1/whoop-mcp",
  "publishConfig": {
    "access": "public"
  }
}
